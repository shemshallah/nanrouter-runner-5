# Common
NANROUTER_FABRIC_TOKEN=replace-with-32-plus-random-characters
NANROUTER_RUNNER_STATE_DIR=/data/runner-state
PORT=8080

# Agent mode
NANROUTER_URL=https://your-nanrouter-hub.example
NANROUTER_RUNNER_SLOT=0
NANROUTER_RUNNER_HW=5
NANROUTER_RUNNER_POLL_SECONDS=5
# Optional explicit relay. Prefer the kind-prefix route table below.
# NANROUTER_RUNNER_RELAY_DESTINATION=0
# NANROUTER_RUNNER_ROUTES={"hermes.":2,"wordnet.":4,"vector":0}

# Hub mode (nanrouter-runner-0)
# FABRIC_DB=/data/point-fabric.sqlite
# HUB_ACTIVE_POINTS=0,2
