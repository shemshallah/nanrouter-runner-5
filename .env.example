# Koyeb portal + atomic runner-ring authority
NANROUTER_RING_URL=https://nannet.apps.mistral.run
NANROUTER_RING_TOKEN=replace-with-32-plus-random-characters

# This runner's public HTTPS origin (the active slot advertises it to the ring)
NANROUTER_RUNNER_URL=https://runner-0.example

# Local durable state
NANROUTER_RUNNER_STATE_DIR=/data/runner-state

# Temporal handoff
NANROUTER_RUNNER_TTL_SECONDS=30
NANROUTER_RUNNER_POLL_SECONDS=2
NANROUTER_RUNNER_CHECKPOINT_SECONDS=5

# 7 GiB
NANROUTER_RUNNER_MEMORY_BYTES=7516192768

# Health
PORT=8080
NANROUTER_RUNNER_HEALTH_HOST=0.0.0.0
