# Common
NANROUTER_FABRIC_TOKEN=replace-with-32-plus-random-characters
RUNNER_STATE_DIR=/data/runner-state
PORT=8080

# Agent mode
NANROUTER_URL=https://your-nanrouter-hub.example
RUNNER_SLOT=0
RUNNER_HW=5
RUNNER_POLL_SECONDS=5
